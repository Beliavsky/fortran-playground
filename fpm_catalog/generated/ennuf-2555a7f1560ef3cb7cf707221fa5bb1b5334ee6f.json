  "files": {
    "playground-generated/ennuf_example_mod.f90": "\n!  ! Easy Neural Networks in the Um in Fortran: Fixed-weight 2-2-1 ReLU example;\n!  not a trained model.\nMODULE ennuf_example_mod\nIMPLICIT NONE\nCONTAINS\nSUBROUTINE ennuf_example(features, y_output)\nUSE neural_net_mod, ONLY: activation_function, dense\nIMPLICIT NONE\nREAL(KIND=4) :: features(1, 2)\n\n\nREAL(KIND=4) :: w_hidden(2, 2)\nREAL(KIND=4) :: b_hidden(2)\nREAL(KIND=4) :: y_hidden(1,2)\n\n\nREAL(KIND=4) :: y_relu(1,2)\n\nREAL(KIND=4) :: w_output(1, 2)\nREAL(KIND=4) :: b_output(1)\nREAL(KIND=4) :: y_output(1,1)\n\n\n\nDATA b_hidden / 0.5, -0.25 /\n\n\nDATA w_hidden(1, :) / 1.0, 2.0 /\n\nDATA w_hidden(2, :) / -1.0, 0.5 /\n\n\n\nDATA b_output / 1.0 /\n\n\nDATA w_output(1, :) / 2.0, -3.0 /\n\n\n\n\nCALL dense(features, y_hidden, 1, 2, 2, w_hidden, b_hidden)\n\nCALL activation_function(y_hidden, y_relu, 1, 2, 'relu      ' )\n\nCALL dense(y_relu, y_output, 1, 2, 1, w_output, b_output)\n\n\n\nRETURN\nEND SUBROUTINE ennuf_example\nEND MODULE ennuf_example_mod\n"
  }
