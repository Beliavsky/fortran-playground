  "review_notes": {
    "stdlib": "Selected subclasses cover documented linear algebra, summary statistics, random numbers, strings, containers, sorting and error handling. A and C remain broad pending a pinned-routine inventory.",
    "fortran_function_parser": "N3 covers expression text processing. C remains broad; this review does not inventory each supported mathematical function.",
    "m_calculator": "N3 covers expression text processing. C remains broad pending an inventory of built-in functions; numeric evaluation is not symbolic algebra.",
    "kinds": "A and R remain broad: precision-kind declarations alone do not establish arithmetic algorithms or a machine-constant API.",
    "datetime-fortran": "R has no immediate date/time subclass. Calendar services retain the parent assignment.",
    "m_time": "R has no immediate date/time subclass. Calendar services retain the parent assignment.",
    "functional-fortran": "N4 covers array/container operations. The general programming support remains at S rather than claiming transformation or analysis tools.",
    "popen-fortran": "N1 covers captured process output. Process support remains at S; no immediate analysis-tool subclass is claimed.",
    "quaff": "Dimensioned arithmetic and unit conversion retain A/Z. No immediate arithmetic subtype is claimed without reviewing the representation-specific API.",
    "metis-fpm": "Sparse-matrix ordering remains at D and graph partitioning at P; this is not a linear-system solver assignment.",
    "forpca": "D4 and D6 describe the eigenvalue/SVD methods. PCA retains the parent L assignment rather than guessing an immediate statistical subclass.",
    "neural-fortran": "G1 covers gradient-based network training. K remains broad because the package is not restricted to least-squares fitting.",
    "spectrum": "J1/J2 cover transforms and convolution, K5 smoothing. General signal-data handling retains N without claiming a specific data-management operation.",
    "fmin": "G1 denotes scalar minimization using a finite search interval; it does not claim support for general nonlinear constraints.",
    "powellopt": "G2 is supported by BOBYQA bound constraints and COBYLA constraints. No unconstrained subclass is inferred solely from the Powell family name.",
    "fstats": "Distribution evaluation, random sampling, summaries, statistical tests, resampling, regression and MCMC support the selected statistical and simulation subclasses.",
    "daskr": "I1 includes the package's ordinary differential-algebraic systems; this assignment does not claim PDE or integral-equation solvers.",
    "diffeq": "I1 includes both the ordinary differential and differential-algebraic integrators."
  },
