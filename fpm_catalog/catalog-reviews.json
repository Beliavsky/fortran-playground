                }
              ],
              "usage": "program bounded_minimum\n  use kind_module, only: wp\n  use bobyqa_module, only: bobyqa\n  implicit none\n  integer, parameter :: n=2, npt=5\n  real(wp) :: x(n), xl(n), xu(n), f\n  x=[0.5_wp,0.5_wp]\n  xl=[0.0_wp,0.0_wp]\n  xu=[1.0_wp,1.0_wp]\n  call bobyqa(n,npt,x,xl,xu,0.2_wp,1.0e-8_wp,0,1000,objective)\n  call objective(n,x,f)\n  print *, x, f\ncontains\n  subroutine objective(n,x,f)\n    integer, intent(in) :: n\n    real(wp), intent(in) :: x(:)\n    real(wp), intent(out) :: f\n    f=(x(1)-2.0_wp)**2+(x(2)+1.0_wp)**2\n  end subroutine objective\nend program bounded_minimum",
              "usage_notes": "Illustrative complete calling program only; not compiled or run for this independent review. Provide the callback as an internal or module subroutine so its assumed-shape interface is explicit. The mathematical reference solution for this particular [0,1]^2 quadratic is X=(1,0), F=2, but no output from this illustration is claimed. This is not the separately checked playground driver. See the pinned declaration links for all inputs and callback types. Bounds, interpolation geometry, scale, evaluation budget and absence of a returned success flag remain caller responsibilities.",
