{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beliavsky.github.io/fortran-playground/catalog/catalog-v1.schema.json",
  "title": "Fortran playground software catalog export, version 1",
  "type": "object",
  "required": ["$schema", "schema_version", "publisher", "snapshot_id", "provenance", "taxonomies", "projects"],
  "properties": {
    "$schema": {"const": "https://beliavsky.github.io/fortran-playground/catalog/catalog-v1.schema.json"},
    "schema_version": {"const": 1},
    "publisher": {"const": "fortran-playground"},
    "snapshot_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "provenance": {
      "type": "object",
      "required": ["repository", "source_commit", "base_commit", "inputs_modified", "hash_normalization", "inputs"],
      "properties": {
        "repository": {"const": "https://github.com/Beliavsky/fortran-playground"},
        "source_commit": {"$ref": "#/$defs/commit"},
        "base_commit": {"$ref": "#/$defs/commit"},
        "inputs_modified": {"type": ["boolean", "null"]},
        "hash_normalization": {"const": "utf-8-lf"},
        "inputs": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["path", "sha256"],
            "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
          }
        }
      }
    },
    "taxonomies": {
      "type": "object", "required": ["gams"],
      "properties": {
        "gams": {
          "type": "object", "required": ["source", "retrieved_on", "classes"],
          "properties": {
            "source": {"const": "https://gams.nist.gov/cgi-bin/serve.cgi"},
            "retrieved_on": {"type": "string", "format": "date"},
            "classes": {
              "type": "object", "minProperties": 20,
              "additionalProperties": {
                "type": "object", "required": ["label", "parent"],
                "properties": {"label": {"type": "string", "minLength": 1}, "parent": {"type": ["string", "null"]}}
              }
            }
          }
        }
      }
    },
    "owners": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9_.-]+$"},
      "additionalProperties": {
        "type": "object", "required": ["login", "display_name", "account_type", "profile_url", "source_url", "retrieved_at"],
        "properties": {
          "login": {"type": "string", "minLength": 1},
          "display_name": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
          "account_type": {"enum": ["User", "Organization", "Bot"]},
          "profile_url": {"type": "string", "format": "uri"},
          "source_url": {"type": "string", "format": "uri"},
          "retrieved_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "attributions": {
      "type": "object", "required": ["schema", "owner_names", "project_authors"],
      "properties": {
        "schema": {"const": 1},
        "owner_names": {
          "type": "object", "propertyNames": {"pattern": "^[a-z0-9_.-]+$"},
          "additionalProperties": {"$ref": "#/$defs/nameAttribution"}
        },
        "project_authors": {
          "type": "object", "propertyNames": {"pattern": "^github:[a-z0-9_.-]+/[a-z0-9_.-]+$"},
          "additionalProperties": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nameAttribution"}}
        }
      }
    },
    "projects": {"type": "array", "items": {"$ref": "#/$defs/project"}},
    "demonstrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "procedure_id", "package_id", "gams_code", "revision", "source_sha256", "url", "path", "license", "license_files", "validation_path"],
        "properties": {
          "id": {"type": "string"}, "procedure_id": {"type": "string"}, "package_id": {"type": "string"},
          "gams_code": {"type": "string"}, "revision": {"$ref": "#/$defs/commit"},
          "source_sha256": {"$ref": "#/$defs/sha256"}, "url": {"type": "string", "format": "uri"},
          "path": {"type": "string"}, "license": {"type": "string"},
          "license_files": {"$ref": "#/$defs/strings"}, "validation_path": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "nameAttribution": {
      "type": "object", "required": ["name", "status", "scope", "rationale", "reviewed_on", "evidence"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "status": {"enum": ["confirmed", "inferred"]},
        "scope": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "reviewed_on": {"type": "string", "format": "date"},
        "evidence": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["url", "description"],
            "properties": {"url": {"type": "string", "format": "uri", "pattern": "^https://"}, "description": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": ["string", "null"], "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "timestamp": {"type": ["string", "null"], "format": "date-time"},
    "project": {
      "type": "object",
      "required": ["id", "name", "repository", "description", "languages", "build_systems", "categories", "license", "github", "curation"],
      "properties": {
        "id": {"type": "string", "pattern": "^github:[a-z0-9_.-]+/[a-z0-9_.-]+$"},
        "name": {"type": "string", "minLength": 1},
        "repository": {
          "type": "object", "required": ["host", "owner", "name", "url"],
          "properties": {
            "host": {"const": "github"}, "owner": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1}, "url": {"type": "string", "format": "uri"}
          }
        },
        "description": {"type": "string"},
        "languages": {"$ref": "#/$defs/strings"},
        "build_systems": {"$ref": "#/$defs/strings"},
        "categories": {"$ref": "#/$defs/strings"},
        "license": {
          "type": "object", "required": ["label", "spdx_expression"],
          "properties": {"label": {"type": ["string", "null"]}, "spdx_expression": {"type": ["string", "null"]}}
        },
        "github": {
          "type": "object", "required": ["topics", "topics_updated_at", "stars", "stars_updated_at"],
          "properties": {
            "topics": {"$ref": "#/$defs/strings"}, "topics_updated_at": {"$ref": "#/$defs/timestamp"},
            "stars": {"type": ["integer", "null"], "minimum": 0}, "stars_updated_at": {"$ref": "#/$defs/timestamp"}
          }
        },
        "curation": {
          "type": "object", "required": ["topics", "gams_codes", "gams_review_level", "gams_notes", "reviewed_revision"],
          "properties": {
            "topics": {"$ref": "#/$defs/strings"}, "gams_codes": {"$ref": "#/$defs/strings"},
            "gams_review_level": {"enum": ["discovery", "source-reviewed", "driver-verified"]},
            "gams_notes": {"type": "string"}, "reviewed_revision": {"$ref": "#/$defs/commit"},
            "numerical_review": {
              "type": "object", "required": ["revision", "archive_sha256", "status", "procedure_ids", "notes"],
              "properties": {
                "revision": {"$ref": "#/$defs/commit"}, "archive_sha256": {"$ref": "#/$defs/sha256"},
                "status": {"enum": ["procedure-reviewed", "support-only"]},
                "procedure_ids": {"$ref": "#/$defs/strings"}, "notes": {"type": "string"}
              }
            },
            "procedures": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "package_id", "revision", "module", "procedure", "gams_codes", "review_level", "derivatives", "evidence", "author_examples"],
                "properties": {
                  "id": {"type": "string"}, "package_id": {"type": "string"}, "revision": {"$ref": "#/$defs/commit"},
                  "module": {"type": "string"}, "procedure": {"type": "string"}, "derivatives": {"type": "string"},
                  "gams_codes": {"$ref": "#/$defs/strings"}, "review_level": {"const": "source-reviewed"},
                  "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "line", "sha256"]}},
                  "author_examples": {"type": "array"}
                }
              }
            }
          }
        },
        "playground": {
          "type": ["object", "null"],
          "required": ["package_id", "catalog_status", "url", "package_revision", "live_service_checked", "example"],
          "properties": {
            "package_id": {"type": "string", "minLength": 1}, "catalog_status": {"const": "selected"},
            "url": {"type": "string", "format": "uri"}, "package_revision": {"$ref": "#/$defs/commit"},
            "live_service_checked": {"const": false},
            "example": {
              "type": "object", "required": ["path", "sha256"],
              "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
            }
          }
        }
      }
    }
  }
}
