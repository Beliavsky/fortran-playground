--- a/fpm.toml
+++ b/fpm.toml
@@ -9,21 +9,3 @@
 categories = ["numerical"]
 keywords = ["cubature", "quadrature", "finite-element", "numerical-integration"]
 
-[features]
-debug.gfortran.flags = "-g -Wall -fbacktrace -fcheck=all -Wextra -Wpedantic -Wuninitialized -Wmaybe-uninitialized -Wimplicit-interface -Wimplicit-procedure -Warray-temporaries -Wrealloc-lhs -finit-real=snan -finit-integer=-2147483648 -finit-logical=true -fstack-protector-all"
-debug.gfortran.linux.flags = "-fsanitize=address,undefined"
-debug.ifx.linux.flags = "-g -check all -warn all -traceback -fpe0 -init=snan,arrays -ftrapuv -fp-stack-check -diag-error-limit 10 -fsanitize=address,undefined"
