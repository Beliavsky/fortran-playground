-# -Mchkptr is omitted: it reports a null pointer inside list-directed derived-type I/O
-debug.nvfortran.flags = "-g -Minform=inform -Mbounds -Mchkstk -Mstandard -Ktrap=fp -traceback"
-debug.flang.flags = "-g"
-
-release.gfortran.flags = "-O3 -fbacktrace -march=native -funroll-loops"
-release.ifx.linux.flags = "-O3 -xHost -unroll"
-release.ifx.windows.flags = "/O3 /QxHost /Qunroll"
-release.nvfortran.flags = "-Mrecursive -fast"
-release.flang.flags = "-O3"
-
-[profiles]
-debug = ["debug"]
-release = ["release"]
